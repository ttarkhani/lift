# Public URL of the app, used to build absolute links.
APP_BASE_URL=http://localhost:3000
# Event name shown in the app.
EVENT_NAME="Hack the Hill"
# IANA time zone used to display event times.
EVENT_TIMEZONE=America/Toronto
# Postgres + TimescaleDB. Local Docker by default; for Tiger Cloud use its service URL with ?sslmode=require.
DATABASE_URL=postgres://lifts:lifts@localhost:5432/lifts
# Separate database for integration tests. Its contents are wiped on every test run.
TEST_DATABASE_URL=postgres://lifts:lifts@localhost:5432/lift_test
# Set to 1 to let the seed script run against a non-local database. Never against production.
ALLOW_REMOTE_SEED=0
# Auth0 Regular Web Application (see docs/auth0-setup.md). Share real values privately, never in git.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=
